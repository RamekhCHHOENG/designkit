{
  "name": "@ramekhchhoeng/designkit",
  "version": "1.1.2",
  "description": "Apple-inspired, accessible React components for web applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:docs": "npm run typecheck && vite build -c vite.config.ts --outDir docs-dist",
    "build": "npm run build:lib && npm run build:docs",
    "package:verify": "node scripts/verify-package.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "verify": "npm run typecheck && npm test && npm run build && npm run package:verify && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run build:lib && npm run package:verify && npm run pack:check",
    "graph:index": "graphify extract . --code-only && graphify cluster-only . --no-label",
    "graph:update": "graphify update .",
    "graph:query": "graphify query"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@changesets/cli": "^2.31.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.17.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamekhCHHOENG/designkit.git"
  },
  "homepage": "https://designkit-smoky.vercel.app/",
  "bugs": {
    "url": "https://github.com/RamekhCHHOENG/designkit/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "typescript",
    "apple-inspired",
    "ui"
  ],
  "author": "Ramekh CHHOENG",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
