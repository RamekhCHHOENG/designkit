      "content": "import { EChart, type EChartSetup } from \"@/components/ui/echart\"\nimport type { EChartsOption } from \"echarts\"\n\n// Adapted from the Apache ECharts example \"ThemeRiver\" (Apache-2.0):\n// https://echarts.apache.org/examples/en/editor.html?c=themeRiver-basic\nconst setup: EChartSetup = () => {\n  let option!: EChartsOption\n  option = {\n    tooltip: {\n      trigger: 'axis',\n      axisPointer: {\n        type: 'line',\n        lineStyle: {\n          color: 'rgba(0,0,0,0.2)',\n          width: 1,\n          type: 'solid'\n        }\n      }\n    },\n\n    legend: {\n      data: ['DQ', 'TY', 'SS', 'QG', 'SY', 'DD'],\n      top: 15\n    },\n\n    singleAxis: {\n      top: 50,\n      bottom: 50,\n      axisTick: {},\n      axisLabel: {},\n      type: 'time',\n      axisPointer: {\n        animation: true,\n        label: {\n          show: true\n        }\n      },\n      splitLine: {\n        show: true,\n        lineStyle: {\n          type: 'dashed',\n          opacity: 0.2\n        }\n      }\n    },\n\n    series: [\n      {\n        type: 'themeRiver',\n        emphasis: {\n          itemStyle: {\n            shadowBlur: 20,\n            shadowColor: 'rgba(0, 0, 0, 0.8)'\n          }\n        },\n        data: [\n          ['2015/11/08', 10, 'DQ'],\n          ['2015/11/09', 15, 'DQ'],\n          ['2015/11/10', 35, 'DQ'],\n          ['2015/11/11', 38, 'DQ'],\n          ['2015/11/12', 22, 'DQ'],\n          ['2015/11/13', 16, 'DQ'],\n          ['2015/11/14', 7, 'DQ'],\n          ['2015/11/15', 2, 'DQ'],\n          ['2015/11/16', 17, 'DQ'],\n          ['2015/11/17', 33, 'DQ'],\n          ['2015/11/18', 40, 'DQ'],\n          ['2015/11/19', 32, 'DQ'],\n          ['2015/11/20', 26, 'DQ'],\n          ['2015/11/21', 35, 'DQ'],\n          ['2015/11/22', 40, 'DQ'],\n          ['2015/11/23', 32, 'DQ'],\n          ['2015/11/24', 26, 'DQ'],\n          ['2015/11/25', 22, 'DQ'],\n          ['2015/11/26', 16, 'DQ'],\n          ['2015/11/27', 22, 'DQ'],\n