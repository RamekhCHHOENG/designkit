  "files": [
    {
      "path": "src/blocks/otp-05/page.tsx",
      "content": "import { GalleryVerticalEndIcon } from \"lucide-react\"\nimport { Button } from \"@/components/ui/button\"\nimport { Field, FieldDescription, FieldGroup, FieldLabel } from \"@/components/ui/field\"\nimport { InputOTP, InputOTPGroup, InputOTPSlot } from \"@/components/ui/input-otp\"\n\nexport default function Page() {\n  return (\n    <div className=\"flex min-h-svh flex-col items-center justify-center gap-6 bg-background p-6 md:p-10\">\n      <div className=\"flex w-full max-w-xs flex-col gap-6\">\n        <form onSubmit={(e) => e.preventDefault()}>\n          <FieldGroup>\n            <div className=\"flex flex-col items-center gap-2 text-center\">\n              <a href=\"#\" className=\"flex flex-col items-center gap-2 font-medium\">\n                <div className=\"flex size-8 items-center justify-center rounded-md\">\n                  <GalleryVerticalEndIcon className=\"size-6\" />\n                </div>\n                <span className=\"sr-only\">Acme Inc.</span>\n              </a>\n              <h1 className=\"text-xl font-bold\">Enter verification code</h1>\n              <FieldDescription>We sent a 6-digit code to your email address</FieldDescription>\n            </div>\n            <Field className=\"items-center\">\n              <FieldLabel htmlFor=\"otp\" className=\"sr-only\">\n                Verification code\n              </FieldLabel>\n              <InputOTP maxLength={6} id=\"otp\" required containerClassName=\"justify-center\">\n                <InputOTPGroup className=\"gap-2 *:data-[slot=input-otp-slot]:rounded-md *:data-[slot=input-otp-slot]:border\">\n                  <InputOTPSlot index={0} />\n                  <InputOTPSlot index={1} />\n                  <InputOTPSlot index={2} />\n                  <InputOTPSlot index={3} />\n                  <InputOTPSlot index={4} />\n                  <InputOTPSlot index={5} />\n                </InputOTPGroup>\n              </InputOTP>\n              <FieldDescription className=\"text-center\">\n                Didn&apos;t receive the code? <a href=\"#\">Resend</a>\n              </FieldDescription>\n            </Field>\n            <Field>\n              <Button type=\"submit\">Verify</Button>\n            </Field>\n          </FieldGroup>\n        </form>\n        <FieldDescription className=\"px-6 text-center\">\n          By clicking continue, you agree to our <a href=\"#\">Terms of Service</a> and{\" \"}\n          <a href=\"#\">Privacy Policy</a>.\n        </FieldDescription>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "src/blocks/otp-05/page.tsx"
    }
  ],
  "categories": [
    "otp"
  ],
  "type": "registry:block"
}