{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "otp-05",
  "title": "OTP 05",
  "description": "A minimal OTP form with separated slots.",
  "dependencies": [
    "lucide-react@^0.562.0"
  ],
  "registryDependencies": [
    "https://designkit-smoky.vercel.app/r/button.json",
    "https://designkit-smoky.vercel.app/r/field.json",
    "https://designkit-smoky.vercel.app/r/input-otp.json"
