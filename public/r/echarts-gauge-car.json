              fontFamily: 'Arial',\n              fontSize: 12,\n              lineHeight: 22,\n              color: '#fff',\n              align: 'left'\n            }\n          }\n        },\n        progress: {\n          show: true,\n          width: 3,\n          itemStyle: {\n            color: '#fff'\n          }\n        },\n        data: [\n          {\n            value: 250,\n            name: ''\n          }\n        ]\n      },\n      {\n        name: 'gauge 5',\n        type: 'gauge',\n        min: 0,\n        max: 1,\n        startAngle: 125,\n        endAngle: 55,\n        splitNumber: 2,\n        radius: '34%',\n        center: ['79%', '55.3%'],\n        axisLine: {\n          lineStyle: {\n            width: 9,\n            color: [\n              [0.15, '#f00'],\n              [1, 'rgba(255, 0, 0, 0)']\n            ]\n          }\n        },\n        splitLine: {\n          distance: -14,\n          length: 16,\n          lineStyle: {\n            color: '#fff',\n            width: 4\n          }\n        },\n        axisTick: {\n          distance: -14,\n          length: 10,\n          lineStyle: {\n            color: '#fff',\n            width: 2\n          }\n        },\n        axisLabel: {\n          distance: 12,\n          fontSize: 18,\n          fontWeight: 800,\n          fontFamily: 'Arial',\n          color: '#fff',\n          formatter: function (value) {\n            if (value === 0.5) {\n              return '2/4';\n            }\n            if (value === 1) {\n              return '4/4';\n            }\n            return value + '';\n          }\n        },\n        progress: {\n          show: true,\n          width: 5,\n          itemStyle: {\n            color: '#fff'\n          }\n        },\n        anchor: {\n          show: true,\n          itemStyle: {},\n          offsetCenter: ['-22%', '-57%'],\n          size: 18,\n          icon: 'path://M1.11979167,1.11111112 C1.11979167,0.497461393 1.61725306,0 2.23090279,0 L12.23