{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar-32",
  "title": "Calendar 32",
  "description": "Date picker in a drawer.",
  "dependencies": [
    "lucide-react@^0.562.0"
  ],
  "registryDependencies": [
    "https://designkit-smoky.vercel.app/r/button.json",
    "https://designkit-smoky.vercel.app/r/calendar.json",
    "https://designkit-smoky.vercel.app/r/drawer.json",
    "https://designkit-smoky.vercel.app/r/label.json"
  ],
  "files": [
    {
      "path": "src/blocks/calendar-32/page.tsx",
      "content": "import * as React from \"react\"\nimport { CalendarPlusIcon } from \"lucide-react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Calendar } from \"@/components/ui/calendar\"\nimport {\n  Drawer,\n  DrawerContent,\n  DrawerDescription,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/components/ui/drawer\"\nimport { Label } from \"@/components/ui/label\"\n\nfunction Calendar32() {\n  const [open, setOpen] = React.useState(false)\n  const [date, setDate] = React.useState<Date | undefined>(undefined)\n\n  return (\n    <div className=\"flex flex-col gap-3\">\n      <Label htmlFor=\"date\" className=\"px-1\">\n        Date of birth\n      </Label>\n      <Drawer open={open} onOpenChange={setOpen}>\n        <DrawerTrigger\n          render={<Button\n            variant=\"outline\"\n            id=\"date\"\n            className=\"w-48 justify-between font-normal\" />}\n        >\n          {date ? date.toLocaleDateString() : \"Select date\"}\n            <CalendarPlusIcon />\n        </DrawerTrigger>\n        <DrawerContent className=\"w-auto overflow-hidden p-0\">\n          <DrawerHeader className=\"sr-only\">\n            <DrawerTitle>Select date</DrawerTitle>\n            <DrawerDescription>Set your date of birth</DrawerDescription>\n          </DrawerHeader>\n          <Calendar\n            mode=\"single\"\n            selected={date}\n            captionLayout=\"dropdown\"\n            onSelect={(date) => {\n              setDate(date)\n              setOpen(false)\n            }}\n            className=\"mx-auto [--cell-size:clamp(0px,calc(100vw/7.5),52px)]\"\n          />\n        </DrawerContent>\n      </Drawer>\n      <div className=\"text-muted-foreground px-1 text-sm\">\n        This example works best on mobile.\n      </div>\n    </div>\n  )\n}\n\nexport default function Page() {\n  return (\n    <div className=\"flex min-h-svh items-center justify-center p-6\">\n      <Calendar32 />\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "src/blocks/calendar-32/page.tsx"
    }
  ],
  "categories": [
    "calendar"
  ],
  "type": "registry:block"
}